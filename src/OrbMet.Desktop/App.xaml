<Application x:Class="OrbMet.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OrbMet.Desktop"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Menus.xaml" />
                <ResourceDictionary Source="Themes/Windows.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Replaced when the user picks a background colour (UsagePalette.ApplyTheme). -->
            <SolidColorBrush x:Key="SurfaceBrush" Color="Black" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
